# ==============================================
# DOCUCOLLAB BACKEND - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ==============================================

# ---- SERVER ----
HOST=0.0.0.0
PORT=1337
SOCKET_PORT=3001
FRONTEND_URL=http://localhost:5173

# ---- STRAPI SECRETS (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
APP_KEYS=CHANGE_ME_KEY1,CHANGE_ME_KEY2
ADMIN_JWT_SECRET=CHANGE_ME_ADMIN_JWT_SECRET_32CHARS
API_TOKEN_SALT=CHANGE_ME_API_TOKEN_SALT_16CH
TRANSFER_TOKEN_SALT=CHANGE_ME_TRANSFER_TOKEN_SALT
JWT_SECRET=CHANGE_ME_JWT_SECRET_32CHARS_MIN
ENCRYPTION_KEY=any_random_32_character_string_here

# ---- DATABASE ----
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# ---- CLOUDINARY (https://cloudinary.com/console) ----
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

# ---- EMAIL / NODEMAILER (for invite emails) ----
# Use Gmail app password OR a transactional service like SendGrid/Mailgun
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com
